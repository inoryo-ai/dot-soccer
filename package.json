{
  "name": "dot-soccer",
  "version": "0.2.0",
  "private": true,
  "description": "ドットサッカー育成ゲーム（MVP）— TypeScript 版",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sim": "node src/cli/main.ts",
    "play": "node src/cli/main.ts play",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build:web": "node scripts/build_web.ts",
    "dev": "node scripts/dev_server.ts",
    "check": "node scripts/check_project.ts",
    "measure": "node scripts/measure.ts",
    "viewer": "node scripts/match_viewer.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
