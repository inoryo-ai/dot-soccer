{
  // 🔑 ブラウザへ配る JS を作る設定（`node scripts/build_web.ts` から呼ばれる）。
  //    入口（main.ts）からたどれるファイルだけを出す。`src/node/` `src/cli/` は
  //    ファイルを触るので、ブラウザには出さない（たどれないので出ない）。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    // 🔴 配る JS にコメントを載せない。ここに書いた説明は**そのまま公開される**
    //    （2026-10-02 に取引先の名前が1件、公開一歩手前まで行った）。
    //    手元のソースは何も変わらない。変わるのは `web/dist/js/` だけ。
    "removeComments": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "web/dist/js",
    "rootDir": "src",
    "types": [],
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "sourceMap": false,
    "declaration": false
  },
  "include": [],
  // 🔑 入口は4つ。`main.ts` がゲーム本体で、残りは**パーツの確認台**。
  //    確認台はゲーム本体からたどれない＝本体の動きに影響しない。
  //      lab.ts     … 選手（ブロック3D）
  //      pitch3d.ts … ピッチ・スタジアム・ボール
  //      faces.ts   … 顔（髪20×顔10×色5）
  //    🔴 ここに足し忘れると `web/face.js が足りない` で組み立てが止まる。
  //       入口から辿れないファイルは出ないため。
  "files": ["src/web/main.ts", "src/web/lab.ts", "src/web/pitch3d.ts",
            "src/web/faces.ts"]
}
